# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=true
PORT=8000
SESSION_LIFETIME_DAYS=14

# AI rate limiting (requests per user per window; default window = 1 hour)
AI_RATE_LIMIT=20
AI_RATE_WINDOW_SECONDS=3600

# AWS Bedrock (rotate if previously committed to version control)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_here
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Email API Configuration (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
